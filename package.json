{
  "name": "oceanic-collector",
  "description": "A collection of Oceanic.js collectors",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "url": "https://github.com/catplvsplus/oceanic-collector",
    "type": "git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "oceanic.js": "^1.14.0"
  },
  "dependencies": {
    "@discordjs/collection": "^2.1.1",
    "@vladfrangu/async_event_emitter": "^2.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.0"
  }
}
